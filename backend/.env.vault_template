# ============================================================
# NeuroSight AI — Vault Secret Template (.env.vault_template)
# ============================================================
#
# This file serves as a guide and template for injecting production
# secrets via HashiCorp Vault instead of committing plaintext .env files.
#
# Path in Vault KV (v2): secret/data/neurosight/production/backend
#
# ------------------------------------------------------------
# 1. Secret Payload JSON (Upload via: vault kv put secret/neurosight/production/backend @payload.json)
# ------------------------------------------------------------
# {
#   "SECRET_KEY": "generate-a-secure-32-byte-hex-string-for-sessions",
#   "JWT_SECRET_KEY": "generate-another-secure-32-byte-hex-string-for-tokens",
#   "POSTGRES_PASSWORD": "secure-production-database-password-here",
#   "REDIS_PASSWORD": "secure-production-redis-password-here",
#   "QDRANT_API_KEY": "secure-qdrant-api-key-if-applicable",
#   "SENTRY_DSN": "https://sentry-dsn-url-if-applicable"
# }
#
# ------------------------------------------------------------
# 2. Vault Agent Template (Consul-Template Syntax)
# Place this config in vault-agent-config.hcl to auto-render backend/.env:
# ------------------------------------------------------------
# template {
#   source      = "/etc/vault/templates/env.tpl"
#   destination = "/app/backend/.env"
# }
#
# ------------------------------------------------------------
# 3. Vault Template File (/etc/vault/templates/env.tpl)
# ------------------------------------------------------------
{{- with secret "secret/data/neurosight/production/backend" -}}
ENVIRONMENT=production
DEBUG=false
API_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# Core Secrets
SECRET_KEY={{ .Data.data.SECRET_KEY }}
JWT_SECRET_KEY={{ .Data.data.JWT_SECRET_KEY }}
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# Database Credentials
POSTGRES_HOST=neurosight-db-host
POSTGRES_PORT=5432
POSTGRES_DB=neurosight
POSTGRES_USER=neurosight
POSTGRES_PASSWORD={{ .Data.data.POSTGRES_PASSWORD }}

# Redis
REDIS_HOST=redis-master
REDIS_PORT=6379
REDIS_DB=0
{{ if .Data.data.REDIS_PASSWORD -}}
REDIS_PASSWORD={{ .Data.data.REDIS_PASSWORD }}
{{- end }}

# Qdrant
QDRANT_HOST=qdrant
QDRANT_PORT=6333
{{ if .Data.data.QDRANT_API_KEY -}}
QDRANT_API_KEY={{ .Data.data.QDRANT_API_KEY }}
{{- end }}

# Celery Broker/Result Backend
CELERY_BROKER_URL=redis://{{ if .Data.data.REDIS_PASSWORD }}:{{ .Data.data.REDIS_PASSWORD }}@{{ end }}redis-master:6379/1
CELERY_RESULT_BACKEND=redis://{{ if .Data.data.REDIS_PASSWORD }}:{{ .Data.data.REDIS_PASSWORD }}@{{ end }}redis-master:6379/2

# Feature Flags & Inference Config
MODEL_DIR=/app/ml-models
EYE_FATIGUE_MODEL_PATH=/app/ml-models/eye_fatigue/model.onnx
VOICE_STRESS_MODEL_PATH=/app/ml-models/voice_stress/model.onnx
PRODUCTIVITY_MODEL_PATH=/app/ml-models/productivity/model.onnx
RL_AGENT_PATH=/app/ml-models/rl_agent/agent.zip
INFERENCE_DEVICE=cpu
ENABLE_VOICE_ANALYSIS=true
ENABLE_RL_RECOMMENDATIONS=true
ENABLE_EDGE_INFERENCE=false
ENABLE_EXPLAINABLE_AI=true

# Monitoring
PROMETHEUS_ENABLED=true
{{ if .Data.data.SENTRY_DSN -}}
SENTRY_DSN={{ .Data.data.SENTRY_DSN }}
{{- end }}
{{- end -}}
