# ============================================================
# NeuroSight AI — Environment Variables
# Copy to .env and fill in your values
# ============================================================

# --- App ---
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=your-super-secret-key-minimum-32-characters-long-here
API_PREFIX=/api/v1

# --- Database (PostgreSQL) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=neurosight
POSTGRES_USER=neurosight
POSTGRES_PASSWORD=your_postgres_password_here

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=your_redis_password_if_needed

# --- Qdrant Vector DB ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
# QDRANT_API_KEY=your_qdrant_cloud_key_if_using_cloud

# --- JWT ---
JWT_SECRET_KEY=your-jwt-secret-key-minimum-32-characters-long
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Celery ---
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- ML Models ---
MODEL_DIR=/app/ml-models
EYE_FATIGUE_MODEL_PATH=/app/ml-models/eye-fatigue/model.onnx
VOICE_STRESS_MODEL_PATH=/app/ml-models/voice-stress/model.onnx
PRODUCTIVITY_MODEL_PATH=/app/ml-models/productivity-predictor/src/xgboost.json
RL_AGENT_PATH=/app/ml-models/rl-agent/agent.zip
INFERENCE_DEVICE=cpu

# --- CORS ---
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# --- Feature Flags ---
ENABLE_VOICE_ANALYSIS=true
ENABLE_RL_RECOMMENDATIONS=true
ENABLE_EDGE_INFERENCE=false
ENABLE_EXPLAINABLE_AI=true

# --- Monitoring ---
PROMETHEUS_ENABLED=true
# SENTRY_DSN=https://your-sentry-dsn-here

# ============================================================
# Frontend (.env.local in /frontend)
# ============================================================
# NEXT_PUBLIC_API_URL=http://localhost:8000
# NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
